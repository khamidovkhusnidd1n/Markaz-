# ========================================================
# Kiberxavfsizlik Markazi Standartlari Bo'yicha Xavfsizlik Sozlamalari
# (OWASP & O'z DSt ISO/IEC 27001 Muvozanati)
# ========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # HTTP dan HTTPS ga avtomatik yo'naltirish
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^(www\.)?uzbamalaka\.uz$ [NC]
    RewriteRule ^ https://uzbamalaka.uz%{REQUEST_URI} [R=301,L]

    # Maxfiy va tizim fayllarini bloklash (.env, .git, .yml, .sql, .bak)
    RewriteRule ^(\.git|\.env|\.local|package\.json|package-lock\.json|tsconfig\.json|\.gitignore|\.htaccess) - [F,L,NC]
    RewriteRule \.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$ - [F,L,NC]

    # SPA (React) marshrutizatsiyasi
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(api|media|static|admin)/
    RewriteRule . /index.html [L]
</IfModule>

# --------------------------------------------------------
# Xavfsizlik Sarlavhalari (Security Headers)
# --------------------------------------------------------
<IfModule mod_headers.c>
    # 1. HSTS (Faqat xavfsiz HTTPS ulanish, 1 yil)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # 2. Clickjacking himoyasi
    Header always set X-Frame-Options "SAMEORIGIN"

    # 3. MIME-sniffing himoyasi
    Header always set X-Content-Type-Options "nosniff"

    # 4. XSS filtri
    Header always set X-XSS-Protection "1; mode=block"

    # 5. Referrer siyosati
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 6. Qurilma ruxsatlari siyosati
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # 7. Server va Passenger signaturalarini yashirish (Information Disclosure himoyasi)
    Header unset X-Powered-By
    Header unset X-Server-Powered-By
    Header always unset X-Powered-By
    Header always unset X-Server-Powered-By
</IfModule>

# --------------------------------------------------------
# Kataloglarni ko'rishni taqiqlash (Directory Browsing)
# --------------------------------------------------------
Options -Indexes -ExecCGI
